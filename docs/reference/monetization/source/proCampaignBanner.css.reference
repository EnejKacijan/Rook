.pro-campaign-banner { padding:16px 18px; margin:18px 0; border:1px solid var(--rook-accent-text); border-radius:18px; background:linear-gradient(120deg,color-mix(in srgb,var(--rook-accent-soft) 65%,var(--rook-surface)),var(--rook-surface)); color:var(--rook-text); }
.pro-campaign-kicker { display:flex; justify-content:space-between; align-items:center; gap:8px; font-size:11px; font-weight:750; letter-spacing:.06em; text-transform:uppercase; color:var(--rook-accent-text); }
.pro-campaign-kicker button { flex-shrink:0; min-width:44px; min-height:44px; margin:-10px -10px -4px 0; border:0; background:transparent; color:var(--rook-secondary); font-size:24px; }
.pro-campaign-headline { display:block; margin-top:9px; font-size:22px; line-height:1.15; letter-spacing:-.025em; }
.pro-campaign-banner p { margin:8px 0 4px; font-size:16px; }
.pro-campaign-banner p b { font-size:22px; font-variant-numeric:tabular-nums; }
.pro-campaign-banner small { display:block; color:var(--rook-secondary); font-size:13px; line-height:1.5; }
.pro-campaign-bottom { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4px 12px; margin-top:8px; }
.pro-campaign-bottom > span { font-size:12px; color:var(--rook-secondary); }
.pro-campaign-bottom button { min-height:44px; padding:8px 0; border:0; background:transparent; color:var(--rook-accent-text); font-weight:750; font-size:14px; }
.pro-campaign-banner button { touch-action:manipulation; cursor:pointer; }
.pro-campaign-banner button:focus-visible { outline:2px solid var(--rook-focus-ring,var(--rook-accent)); outline-offset:3px; }
@media (forced-colors:active) { .pro-campaign-banner { background:Canvas; border-color:CanvasText; } }
.pro-campaign-banner--today { position:relative; padding:13px 100px 13px 14px; border-radius:14px; margin:16px 0; }
.pro-campaign-banner--today .pro-campaign-headline { display:none; }
.pro-campaign-banner--today .pro-campaign-kicker { font-size:11px; letter-spacing:.03em; line-height:1.35; }
.pro-campaign-banner--today .pro-campaign-kicker button { position:absolute; right:2px; top:1px; margin:0; font-size:21px; }
.pro-campaign-banner--today p { margin:5px 0 3px; font-size:13px; line-height:1.3; }
.pro-campaign-banner--today p b { font-size:15px; }
.pro-campaign-banner--today small { font-size:11px; line-height:1.45; }
.pro-campaign-banner--today .pro-campaign-bottom { position:absolute; right:12px; bottom:4px; margin:0; }
.pro-campaign-banner--today .pro-campaign-bottom > span { display:none; }
.pro-campaign-banner--today .pro-campaign-bottom button { font-size:12px; }

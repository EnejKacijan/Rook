VITE_ROOK_FIREBASE_APP_ID=

# ROOK Pro is OFF until RevenueCat Web products, legal URLs and the trusted
# Netlify server are configured and purchase/restore is sandbox verified.
VITE_ROOK_PRO_ROLLOUT=false
VITE_ROOK_REVENUECAT_PUBLIC_KEY=
VITE_ROOK_PRIVACY_URL=
VITE_ROOK_TERMS_URL=
ROOK_PRO_ROLLOUT=false
ROOK_PRO_PRODUCTS_READY=false
# Server only. Never prefix either value with VITE_ or expose it to the client.
ROOK_REVENUECAT_SECRET_KEY=
ROOK_FIREBASE_SERVICE_ACCOUNT_JSON=

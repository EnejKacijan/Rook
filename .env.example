OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMPORT_MODEL=gpt-5-mini
OPENAI_IMPORT_REASONING=low
OPENAI_PLAN_MODEL=gpt-4.1-mini
OPENAI_EXPERT_MODEL=gpt-4.1-mini
EXPERT_LAB_ENABLED=false
EXPERT_POLICY_ENABLED=false

# Server-only AI security. AI is OFF until identity, shared quotas and verified
# model price ceilings are configured. Never prefix credentials with VITE_.
ROOK_AI_ENABLED=false
ROOK_FIREBASE_PROJECT_ID=rook-1d2c8
ROOK_FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively supply server ADC through GOOGLE_APPLICATION_CREDENTIALS.
# JSON keyed by every server model ID; input/output = USD per million tokens.
# Fill using verified current uncached/most-expensive prices, not guessed rates.
ROOK_AI_MODEL_PRICES_JSON=
# 5 USD of conservative reservations per UTC day across all users/functions.
ROOK_AI_DAILY_BUDGET_MICRO_USD=5000000
ROOK_AI_USER_PER_MINUTE=12
ROOK_AI_USER_PER_DAY=60
ROOK_AI_GLOBAL_PER_MINUTE=40
ROOK_AI_GLOBAL_PER_DAY=500
ROOK_AI_USER_CONCURRENCY=2
ROOK_AI_GLOBAL_CONCURRENCY=8
ROOK_AI_MAX_OUTPUT_TOKENS=12000
# Keep false until the browser App Check integration is separately configured.
ROOK_AI_REQUIRE_APP_CHECK=false

# Public Firebase Web app configuration. Sync stays unavailable until the
# reviewed account rollout is explicitly configured for this environment.
VITE_ROOK_ACCOUNT_SYNC_ROLLOUT=false
VITE_ROOK_FIREBASE_API_KEY=
VITE_ROOK_FIREBASE_AUTH_DOMAIN=
VITE_ROOK_FIREBASE_PROJECT_ID=
VITE_ROOK_FIREBASE_STORAGE_BUCKET=
VITE_ROOK_FIREBASE_MESSAGING_SENDER_ID=
VITE_ROOK_FIREBASE_APP_ID=
